generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                String   @id @default(cuid())
  nombres           String
  segundoNombre     String?
  apellidos         String
  segundoApellido   String?
  edad              Int?
  telefono          String?
  correo            String   @unique
  correoEmpresarial String   @unique
  contrasena        String
  fotoPerfil        String?
  cuentaActiva      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("admins")
}

model Cliente {
  id              String      @id @default(cuid())
  nombres         String
  apellidos       String
  telefono        String
  correo          String      @unique
  contrasena      String
  cuentaActiva    Boolean     @default(true)
  fotoPerfil      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  fechaNacimiento DateTime?
  segundoApellido String?
  segundoNombre   String?
  solicitudes     Solicitud[]

  @@map("clientes")
}

model Mecanico {
  id                String        @id @default(cuid())
  nombres           String
  apellidos         String
  edad              Int
  correo            String        @unique
  correoEmpresarial String        @unique
  especialidad      String
  anosExperiencia   Int
  estadoLaboral     EstadoLaboral @default(Disponible)
  cuentaActiva      Boolean       @default(true)
  contrasena        String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  fotoPerfil        String?
  segundoApellido   String?
  segundoNombre     String?
  telefono          String?
  solicitudes       Solicitud[]

  @@map("mecanicos")
}

model Solicitud {
  id                  String          @id @default(cuid())
  nombreCliente       String
  telefono            String
  correoCliente       String
  marca               String
  modelo              String
  anio                String
  placa               String
  kilometraje         String
  tipoServicio        String
  otroServicio        String          @default("")
  descripcionProblema String
  fechaCita           String
  horaCita            String
  provincia           String          @default("")
  ubicacionMecanicaId String          @default("")
  ubicacionMecanicaNombre String       @default("")
  ubicacionMecanicaDireccion String    @default("")
  estado              EstadoSolicitud @default(Pendiente)
  mecanicoId          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  clienteId           String?
  mantenimiento       Mantenimiento?
  cliente             Cliente?        @relation(fields: [clienteId], references: [id])
  mecanico            Mecanico?       @relation(fields: [mecanicoId], references: [id])

  @@map("solicitudes")
}

model Mantenimiento {
  id                   String    @id @default(cuid())
  solicitudId          String    @unique
  marca                String
  modelo               String
  placa                String
  mecanicoAsignado     String
  diagnostico          String
  trabajoRealizado     String
  otroTrabajo          String    @default("")
  repuestosUtilizados  String
  diagnosticoRealizado String
  observaciones        String
  costoManoObra        Decimal   @db.Decimal(10, 2)
  costoRepuestos       Decimal   @db.Decimal(10, 2)
  fechaServicio        String
  fechaInicio          String
  fechaFinalizacion    String
  fotoVehiculo         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  solicitud            Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  finanzas             Finanzas?

  @@map("mantenimientos")
}

model Finanzas {
  id                  String                @id @default(cuid())
  numeroFactura       String                @unique
  mantenimientoId     String                @unique
  clienteNombre       String
  clienteTelefono     String
  clienteCorreo       String
  vehiculo            String
  marca               String
  modelo              String
  placa               String
  anio                String
  kilometraje         String
  servicio            String
  mecanico            String
  costoManoObra       Decimal               @db.Decimal(12, 2)
  costoRepuestos      Decimal               @db.Decimal(12, 2)
  total               Decimal               @db.Decimal(12, 2)
  estado              EstadoFinanzas        @default(Pendiente)
  metodoPago          MetodoPago?
  fechaPago           DateTime?
  observacion         String?
  comprobanteUri      String?
  fechaFactura        DateTime              @default(now())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  mantenimiento       Mantenimiento         @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)

  @@map("finanzas")
}

model PersonalFinanciero {
  id                String   @id @default(cuid())
  nombres           String
  segundoNombre     String?
  apellidos         String
  segundoApellido   String?
  edad              Int?
  telefono          String?
  correo            String   @unique
  correoEmpresarial String   @unique
  contrasena        String
  cuentaActiva      Boolean  @default(true)
  fotoPerfil        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("personal_financiero")
}

model PersonalInventario {
  id                String   @id @default(cuid())
  nombres           String
  segundoNombre     String?
  apellidos         String
  segundoApellido   String?
  edad              Int?
  telefono          String?
  correo            String   @unique
  correoEmpresarial String   @unique
  contrasena        String
  cuentaActiva      Boolean  @default(true)
  fotoPerfil        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("personal_inventario")
}

model CodigoVerificacion {
  id        String   @id @default(cuid())
  correo    String
  codigo    String
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("codigos_verificacion")
}

enum EstadoLaboral {
  Disponible
  Ocupado
  Inactivo
}

enum EstadoSolicitud {
  Pendiente
  En_proceso
  Completado
  Rechazado
}

enum EstadoFinanzas {
  Pendiente
  Pagado
  Cancelado
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model ReporteSoporte {
  id            String   @id @default(cuid())
  nombre        String
  segundoNombre String?
  apellido      String
  segundoApellido String?
  correo        String
  tipoAsunto    String   // "Consulta general", "Problema técnico", "Sugerencia", "Reclamo", "Comprobante", "Otro"
  descripcion   String
  estado        String   @default("Pendiente") // "Pendiente", "En revisión", "Resuelto"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reportes_soporte")
}

model Producto {
  id                   String                    @id @default(cuid())
  nombreProducto       String
  codigoSKU            String                    @unique
  marcaComponente      String
  categoria            String
  numeroParteOEM       String                    @default("")
  descripcion          String
  stockActual          Int
  stockMinimo          Int
  stockCritico         Int
  precioCompra         Decimal                   @db.Decimal(12, 2)
  precioVenta          Decimal                   @db.Decimal(12, 2)
  ubicacion            String
  unidadMedida         String
  compatibilidades     CompatibilidadProducto[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@map("productos")
}

model CompatibilidadProducto {
  id        String   @id @default(cuid())
  productoId String
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  marca     String
  modelo    String
  anoDesde  Int
  anoHasta  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("compatibilidades_productos")
}
