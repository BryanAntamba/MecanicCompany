@startuml diagrama_casos_uso_mecaniccompany
!include <C4/C4_Component>

title Diagrama de Casos de Uso - MecanicCompany
skinparam backgroundColor #FEFEFE
skinparam actorBackgroundColor #E1F5FE
skinparam usecaseBackgroundColor #FFF9C4
skinparam usecase {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
    ArrowColor #424242
}

' Actores
actor Cliente
actor Mecanico as "Mecánico"
actor PersonalInventario as "Personal\nInventario"
actor PersonalFinanciero as "Personal\nFinanciero"
actor Admin as "Administrador"

' Casos de Uso - CLIENTE
rectangle CLIENTE {
    usecase (UC001: Registrarse) as UC001
    usecase (UC002: Iniciar Sesión) as UC002
    usecase (UC003: Solicitar Mantenimiento) as UC003
    usecase (UC004: Ver Estado Solicitud) as UC004
